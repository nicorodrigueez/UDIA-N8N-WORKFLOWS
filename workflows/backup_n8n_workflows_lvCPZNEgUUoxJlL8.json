","webhookId":"c65b2341-2f2f-470f-a990-45cf9fe5744c","credentials":{"githubApi":{"id":"3iaOFNpr6Dw75emV","name":"GitHub account 2"}},"onError":"continueRegularOutput"},{"parameters":{},"type":"n8n-nodes-base.noOp","name":"FIN","typeVersion":1,"position":[1008,-256],"id":"d757b519-cfff-4ff1-b5a8-6170a0cf2282"},{"parameters":{},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[1200,32],"id":"a9c24bc2-4231-425c-a1a0-7b8fac6aa98b","name":"Merge"},{"parameters":{"jsCode":"function deepSort(obj) {\n  if (Array.isArray(obj)) return obj.map(deepSort);\n  if (obj && typeof obj === 'object') {\n    const out = {};\n    for (const k of Object.keys(obj).sort()) out[k] = deepSort(obj[k]);\n    return out;\n  }\n  return obj;\n}\nconst toStableString = (o) => JSON.stringify(deepSort(o), null, 2) + '\\n';\n\nconst out = [];\nfor (const item of items) {\n  const j = item.json;\n\n  // 1) Datos fijos del repo\n  const owner  = j.owner  || 'nicorodrigueez';\n  const repo   = j.repo   || 'UDIA-N8N-WORKFLOWS';\n  const branch = j.branch || 'main';\n\n  // 2) Workflow desde el Set/Build (NO uses Date.now())\n  const wf = j.workflow ?? j.workflowData ?? j;\n  const id = wf.id;                          // n8n siempre tiene id del workflow\n  const safeName = (wf.name || `wf-${id}`).replace(/[^a-z0-9._-]/gi, '_');\n  const path = j.path || `backups/${id}-${safeName}.json`;  // ruta ESTABLE\n\n  // 3) Contenido local (normalizado)\n  const localContent = toStableString(wf);\n\n  // 4) ¿Existe en GitHub? (viene del GET /contents + Merge)\n  let status = 'new';\n  let sha = null;\n\n  if (typeof j.statusCode === 'number' && j.statusCode === 404) {\n    // no existe -> new\n    status = 'new';\n  } else if (j.content) {\n    // existe -> compara\n    try {\n      const remoteStr = Buffer.from(String(j.content).replace(/\\n/g, ''), 'base64').toString('utf-8');\n      status = (remoteStr === localContent) ? 'same' : 'different';\n      sha = j.sha || null;\n    } catch {\n      // si no puedo decodificar, lo trato como diferente para forzar backup\n      status = 'different';\n    }\n  } else {\n    // si no hay statusCode 404 ni content, asumo que no existe\n    status = 'new';\n  }\n\n  out.push({ json: { owner, repo, branch, path, localContent, status, sha }});\n}\nreturn out;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1408,32],"id":"c9aa10ad-ced3-4497-aaf3-d639ac5e1ded","name":"Code in JavaScript"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.status }}","rightValue":"same","operator":{"type":"string","operation":"equals"},"id":"55069b50-b0b9-4823-b8e2-e198f3ead0a8"}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"4fbc38ea-9da1-47d2-ae56-5e9a36045d9f","leftValue":"={{ $json.status }}","rightValue":"Different","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"}},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c0a507fd-b899-464e-9a00-9b6fb1d61498","leftValue":"={{ $json.status }}","rightValue":"new","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"}}]},"options":{}},"type":"n8n-nodes-base.switch","typeVersion":3.3,"position":[1616,16],"id":"2b345598-5a22-43c6-874c-16b17c04969e","name":"Switch"},{"parameters":{},"type":"n8n-nodes-base.noOp","name":"Same","typeVersion":1,"position":[1792,-272],"id":"c4ea411c-0404-4887-abbb-8fdf8016b383"},{"parameters":{"resource":"file","operation":"edit","owner":{"__rl":true,"value":"={{ $('Code in JavaScript').item.json.owner }}","mode":"name"},"repository":{"__rl":true,"value":"={{ $('Code in JavaScript').item.json.repo }}","mode":"name"},"filePath":"={{ $('Code in JavaScript').item.json.path }}","fi